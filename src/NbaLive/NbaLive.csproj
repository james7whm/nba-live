<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net10.0-windows;net48</TargetFrameworks>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>NbaLive</AssemblyName>
    <Version>1.3.1</Version>
    <SatelliteResourceLanguages>zh-Hans;zh-Hant;en;en-US</SatelliteResourceLanguages>
    <Product>NBA 直播条</Product>
    <Title>NBA 直播条</Title>
    <Description>桌面 NBA 文字直播条</Description>
    <ApplicationIcon>Assets/Tray.ico</ApplicationIcon>
  </PropertyGroup>
  <PropertyGroup Condition="'$(LitePackage)' == 'true'">
    <DefineConstants>$(DefineConstants);LITE_PACKAGE</DefineConstants>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../NbaLive.Core/NbaLive.Core.csproj" /></ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="PolySharp" Version="1.15.0" PrivateAssets="all" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net48'">
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <Page Remove="Assets/AppIcon.xaml" />
    <None Include="Assets/AppIcon.xaml" />
    <None Remove="Assets/Tray.ico" />
    <None Include="Assets/Tray.ico" Link="Tray.ico" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Assets/TrayLight.ico" Link="TrayLight.ico" CopyToOutputDirectory="PreserveNewest" />
    <None Update="Assets/TrayDark.ico" Link="TrayDark.ico" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="Assets/Tray.ico" />
    <Resource Include="Assets/Teams/*.png" />
  </ItemGroup>
  <ItemGroup><RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="6" /></ItemGroup>
</Project>
